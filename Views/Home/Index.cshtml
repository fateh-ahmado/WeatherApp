@model List<WeatherApp.Models.WeatherStation>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card" style="max-width: 500px; width: 100%;">
        <div class="card-header">
            Mine steder
        </div>
        @if (Model.Count == 0)
        {
            <div class="card-body">
                <p class="card-text">Ingen steder er lagt til ennå.</p>
                <a asp-controller="WeatherStations" asp-action="Create" class="btn btn-primary">Legg til nytt sted</a>
            </div>
        }
        else
        {
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Sted</th>
                        <th>Tidspunkt</th>
                        <th>Temperatur</th>
                        <th>Vindkast</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stasjon in Model)
                    {
                        var siste = stasjon.Observations.OrderByDescending(o => o.Timestamp).FirstOrDefault();
                        <tr>
                            <td><a asp-controller="WeatherStations" asp-action="Details" asp-route-id="@stasjon.Id">@stasjon.Name</a></td>
                            @if (siste != null)
                            {
                                <td>@siste.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@siste.Temperature °</td>
                                <td>@siste.WindGust m/s</td>
                            }
                            else
                            {
                                <td colspan="3">Ingen målinger</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <div class="card-body">
                <a asp-controller="WeatherStations" asp-action="Index" class="btn btn-secondary">Se alle steder</a>
            </div>
        }
    </div>
</div>
