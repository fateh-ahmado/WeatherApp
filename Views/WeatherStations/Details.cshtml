@model WeatherApp.Models.WeatherStation

<div class="container mt-4">
    <h1>Detaljer om @Model.Name</h1>

    <div class="card mb-4" style="max-width: 400px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Navn</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Breddegrad</dt>
                <dd class="col-sm-8">@Model.Latitude</dd>

                <dt class="col-sm-4">Lengdegrad</dt>
                <dd class="col-sm-8">@Model.Longitude</dd>
            </dl>
        </div>
    </div>

    <h2>Værmålinger for dette stedet</h2>

    @if (Model.Observations.Any())
    {
        <table class="table table-striped" style="table-layout: fixed;">
            <colgroup>
                <col style="width: 33%;" />
                <col style="width: 33%;" />
                <col style="width: 34%;" />
            </colgroup>
            <thead>
                <tr>
                    <th class="text-start">Tidspunkt</th>
                    <th class="text-start">Temperatur</th>
                    <th class="text-start">Vindkast</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obs in Model.Observations)
                {
                    <tr>
                        <td class="text-start">@obs.Timestamp.ToString("dd.MM.yyyy")</td>
                        <td class="text-start">@obs.Temperature</td>
                        <td class="text-start">@obs.WindGust</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Ingen værmålinger registrert ennå for dette stedet.</p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Tilbake til hjem</a>
    <a asp-action="Index" class="btn btn-danger">Endringer</a>
</div>