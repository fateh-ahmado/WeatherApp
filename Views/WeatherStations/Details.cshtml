@model WeatherApp.Models.WeatherStation

<div class="container mt-4">
    <h1>Detaljer om @Model.Name</h1>

    <div class="card mb-4" style="max-width: 400px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Navn</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Breddegrad</dt>
                <dd class="col-sm-8">@Model.Latitude</dd>

                <dt class="col-sm-4">Lengdegrad</dt>
                <dd class="col-sm-8">@Model.Longitude</dd>
            </dl>
        </div>
    </div>

    <h2>Værmålinger for dette stedet</h2>

    @if (Model.Observations.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Tidspunkt</th>
                    <th>Temperatur</th>
                    <th>Vindkast</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obs in Model.Observations)
                {
                    <tr>
                        <td>@obs.Timestamp</td>
                        <td>@obs.Temperature</td>
                        <td>@obs.WindGust</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Ingen værmålinger registrert ennå for dette stedet.</p>
    }

    <a asp-action="Index" class="btn btn-secondary">Tilbake til listen</a>
</div>