@model WeatherApp.Models.WeatherStation

<div class="container mt-4">
    <h1>Legg til nytt sted</h1>

    <form asp-action="Create" method="post" style="max-width: 500px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Stedsnavn</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Latitude" class="form-label">Breddegrad</label>
            <input asp-for="Latitude" class="form-control" />
            <span asp-validation-for="Latitude" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Longitude" class="form-label">Lengdegrad</label>
            <input asp-for="Longitude" class="form-control" />
            <span asp-validation-for="Longitude" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lagre</button>
        <a asp-action="Index" class="btn btn-secondary">Avbryt</a>
    </form>
</div>