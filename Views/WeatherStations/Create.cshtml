@model WeatherApp.Models.WeatherStation

<h1>Legg til nytt sted</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Name">Stedsnavn</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Latitude">Breddegrad</label>
        <input asp-for="Latitude" />
        <span asp-validation-for="Latitude"></span>
    </div>

    <div>
        <label asp-for="Longitude">Lengdegrad</label>
        <input asp-for="Longitude" />
        <span asp-validation-for="Longitude"></span>
    </div>

    <button type="submit">Lagre</button>
</form>

<a asp-action="Index">Tilbake til listen</a>