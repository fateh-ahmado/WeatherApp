@model WeatherApp.Models.WeatherStation

<div class="container mt-4">
    <h1>Slett sted</h1>

    <div class="alert alert-warning" style="max-width: 500px;">
        Er du sikker på at du vil slette dette stedet?
    </div>

    <dl class="row" style="max-width: 500px;">
        <dt class="col-sm-4">Navn</dt>
        <dd class="col-sm-8">@Model.Name</dd>

        <dt class="col-sm-4">Breddegrad</dt>
        <dd class="col-sm-8">@Model.Latitude</dd>

        <dt class="col-sm-4">Lengdegrad</dt>
        <dd class="col-sm-8">@Model.Longitude</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Ja, slett</button>
        <a asp-action="Index" class="btn btn-secondary">Avbryt</a>
    </form>
</div>