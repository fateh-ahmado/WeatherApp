@model WeatherApp.Models.WeatherObservation

<div class="container mt-4">
    <h1>Rediger måling</h1>

    <form asp-action="Edit" method="post" style="max-width: 500px;">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="WeatherStationId" class="form-label">Sted</label>
            <select asp-for="WeatherStationId" class="form-control" asp-items="ViewBag.WeatherStations">
            </select>
            <span asp-validation-for="WeatherStationId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Timestamp" class="form-label">Tidspunkt</label>
            <input asp-for="Timestamp" class="form-control" />
            <span asp-validation-for="Timestamp" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Temperature" class="form-label">Temperatur</label>
            <input asp-for="Temperature" class="form-control" />
            <span asp-validation-for="Temperature" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="WindGust" class="form-label">Vindkast</label>
            <input asp-for="WindGust" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Lagre endringer</button>
        <a asp-action="Index" class="btn btn-secondary">Avbryt</a>
    </form>
</div>